  "starterAdd": "ചേർക്കുക",
  "starterWords": "ദൈനംദിന ഇംഗ്ലീഷ് വാക്കുകൾ (അറബി)",
  "starterCapitals": "ലോക തലസ്ഥാനങ്ങൾ",
  "starterElements": "രാസ മൂലകങ്ങൾ",
  "settingsAccent": "ആക്‌സന്റ് നിറം",
  "accentViolet": "വയലറ്റ്",
  "accentBlue": "നീല",
