  "faqMyDayA": "ದಿನಕ್ಕೆ ಒಮ್ಮೆ ಮುಖಪುಟ ಇದನ್ನು ನೀಡುತ್ತದೆ: ಇಂದಿನ ಕಾರ್ಯಗಳು, ಮುಂದಿನ ಈವೆಂಟ್, ಬಾಕಿ ಅಭ್ಯಾಸಗಳು ಮತ್ತು ಬಾಕಿ ಕಾರ್ಡ್‌ಗಳನ್ನು ನೋಡಿ, ನಂತರ ಒಂದು ಟ್ಯಾಪ್‌ನಲ್ಲಿ ಫೋಕಸ್ ಸೆಷನ್ ಪ್ರಾರಂಭಿಸಿ. ತ್ವರಿತ ಕ್ರಿಯೆಗಳಿಗಾಗಿ ಆ್ಯಪ್ ಐಕಾನ್ ಅನ್ನು ದೀರ್ಘವಾಗಿ ಒತ್ತಿ, ಅಥವಾ ಫೋಕಸ್ ಸಮಯ ಮತ್ತು ಬಾಕಿ ಕಾರ್ಡ್‌ಗಳನ್ನು ನೋಡಲು ಮುಖಪುಟ ವಿಜೆಟ್ ಸೇರಿಸಿ.",
  "faqTasksQ": "ಜ್ಞಾಪನೆಯೊಂದಿಗೆ ಕಾರ್ಯವನ್ನು ಹೇಗೆ ಸೇರಿಸುವುದು?",
  "faqTasksA": "ಮುಖಪುಟದಲ್ಲಿ ಹೊಸ ಕಾರ್ಯ ಅಥವಾ ಕಾರ್ಯಗಳಲ್ಲಿ + ಟ್ಯಾಪ್ ಮಾಡಿ. ಶೀರ್ಷಿಕೆ ಟೈಪ್ ಮಾಡಿ ಅಥವಾ ಮೈಕ್ರೊಫೋನ್‌ನಲ್ಲಿ ಹೇಳಿ, ನಂತರ ಕೊನೆಯ ದಿನಾಂಕ, ಸಮಯ ಮತ್ತು ಜ್ಞಾಪನೆ ಹೊಂದಿಸಿ. ತಡವಾದ ಕಾರ್ಯಗಳನ್ನು ಮೊದಲು ಪಟ್ಟಿ ಮಾಡಲಾಗುತ್ತದೆ.",
  "faqFocusQ": "ಫೋಕಸ್ ಟೈಮರ್ ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ?",
  "faqFocusA": "ಪೊಮೊಡೊರೊ, ಕೌಂಟ್‌ಡೌನ್ ಅಥವಾ ತೆರೆದ ಸಮಯ ಆಯ್ಕೆಮಾಡಿ ಪ್ರಾರಂಭಿಸಿ ಒತ್ತಿ; ವಿರಾಮಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬರಬಹುದು. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಮುಕ್ತಾಯ ಧ್ವನಿ ಆಯ್ಕೆ ಮಾಡಬಹುದು, ಫೋಕಸ್ ಮಾಡುವಾಗ ಅಡಚಣೆ ಮಾಡಬೇಡಿ ಆನ್ ಮಾಡಬಹುದು ಮತ್ತು ಪ್ರತಿ ಸೆಷನ್‌ನೊಂದಿಗೆ ಪ್ರಕೃತಿ ಧ್ವನಿಗಳನ್ನು ಪ್ಲೇ ಮಾಡಬಹುದು.",
  "faqSoundsQ": "ಪ್ರಕೃತಿ ಧ್ವನಿಗಳನ್ನು ಮಿಶ್ರಣ ಮಾಡಬಹುದೇ?",
  "faqSoundsA": "ಆರು ನೈಜ ರೆಕಾರ್ಡಿಂಗ್‌ಗಳವರೆಗೆ ಆನ್ ಮಾಡಿ, ಪ್ರತಿಯೊಂದರ ಧ್ವನಿಮಟ್ಟ ಹೊಂದಿಸಿ ಮತ್ತು ಮಿಶ್ರಣವನ್ನು ಹೆಸರಿನೊಂದಿಗೆ ಉಳಿಸಿ. ಅವು ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಪ್ಲೇ ಆಗುತ್ತಲೇ ಇರುತ್ತವೆ, ಮತ್ತು ನಿದ್ರಾ ಟೈಮರ್ ಅವುಗಳನ್ನು ನಿಲ್ಲಿಸಬಹುದು. ಯಾವುದೇ ಸಂಗೀತ ಬಳಸಲಾಗುವುದಿಲ್ಲ.",
  "faqCalendarQ": "ಕ್ಯಾಲೆಂಡರ್ ಹಿಜ್ರಿ ದಿನಾಂಕಗಳನ್ನು ತೋರಿಸಬಹುದೇ?",
  "faqCalendarA": "ಹೌದು. ಹಿಜ್ರಿ ದಿನಾಂಕಗಳು (ಉಮ್ಮುಲ್ ಕುರಾ) ಅರೇಬಿಕ್‌ನಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕಾಣಿಸುತ್ತವೆ ಮತ್ತು ಯಾವುದೇ ಭಾಷೆಗೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಆನ್ ಮಾಡಬಹುದು. ಈವೆಂಟ್‌ಗಳು, ಕೊನೆಯ ದಿನಾಂಕವಿರುವ ಕಾರ್ಯಗಳು ಮತ್ತು ಪ್ರಾಜೆಕ್ಟ್ ಮೈಲಿಗಲ್ಲುಗಳು ಒಟ್ಟಿಗೆ ಕಾಣಿಸುತ್ತವೆ.",
  "faqFlashcardsQ": "ನಾನು ಯಾವ ಕಾರ್ಡ್‌ಗಳನ್ನು ನೋಡಬೇಕು ಎಂದು ಪುನರಾವಲೋಕನ ಹೇಗೆ ನಿರ್ಧರಿಸುತ್ತದೆ?",
  "faqFlashcardsA": "ನಿಮಗೆ ಚೆನ್ನಾಗಿ ಗೊತ್ತಿರುವ ಕಾರ್ಡ್‌ಗಳು ದೀರ್ಘ ಅಂತರದ ನಂತರ ಮರಳುತ್ತವೆ ಮತ್ತು ತಪ್ಪಿದ ಕಾರ್ಡ್‌ಗಳು ಬೇಗ ಮರಳುತ್ತವೆ (ಅಂತರದ ಪುನರಾವರ್ತನೆ). ಪ್ರತಿ ಉತ್ತರಕ್ಕೆ ಮತ್ತೆ, ಕಷ್ಟ, ಒಳ್ಳೆಯದು ಅಥವಾ ಸುಲಭ ಎಂದು ರೇಟ್ ಮಾಡಿ. ದೈನಂದಿನ ಗುರಿ ಹೊಂದಿಸಿ ಮತ್ತು ಇಂದು ಕಾರ್ಡ್‌ನಲ್ಲಿ ನಿಮ್ಮ ಸರಣಿ ಉಳಿಸಿಕೊಳ್ಳಿ. ಉಳಿದ ದಿನಗಳು ಮತ್ತು ಪ್ರತಿದಿನ ಎಷ್ಟು ಹೊಸ ಕಾರ್ಡ್ ಕಲಿಯಬೇಕು ಎಂದು ನೋಡಲು ಡೆಕ್‌ನಲ್ಲಿ ಪರೀಕ್ಷಾ ದಿನಾಂಕ ಹೊಂದಿಸಿ. ಕಾರ್ಡ್‌ಗಳನ್ನು ಸ್ಥಾನಕ್ಕೆ ಎಳೆಯಲು \"ನನ್ನ ಕ್ರಮ\" ಪ್ರಕಾರ ವಿಂಗಡಿಸಿ, ಕೇಳಲು ಯಾವುದೇ ಬದಿಯ ಸ್ಪೀಕರ್ ಟ್ಯಾಪ್ ಮಾಡಿ, ಮತ್ತು ಮಾತು ಮೆನುವಿನಲ್ಲಿ ವೇಗ ಮತ್ತು ಪುನರಾವರ್ತನೆ ಹೊಂದಿಸಿ.",
  "faqImportQ": "Anki ಅಥವಾ Excel ನಿಂದ ಕಾರ್ಡ್‌ಗಳನ್ನು ತರಬಹುದೇ?",
  "faqImportA": "ಹೌದು. ಡೆಕ್‌ನಲ್ಲಿ ಆಮದು ಆಯ್ಕೆಮಾಡಿ, ನಂತರ ಫೈಲ್ ಆರಿಸಿ: Anki (.apkg), Excel (.xlsx) ಅಥವಾ CSV, ಮತ್ತು ಕಾಲಮ್‌ಗಳನ್ನು ಹೊಂದಿಸಿ. ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಕಾರ್ಡ್ ಬರೆಯಲು “ಸ್ಪ್ರೆಡ್‌ಶೀಟ್ ಟೆಂಪ್ಲೇಟ್” ಬಳಸಿ. Anki ಫೈಲ್‌ಗಳ ಒಳಗಿನ ಚಿತ್ರಗಳು ಮತ್ತು ಧ್ವನಿಗಳನ್ನು ಆಮದು ಮಾಡಲಾಗುವುದಿಲ್ಲ.",
  "faqNotesQ": "ಟಿಪ್ಪಣಿಗಳು ಏನು ಮಾಡಬಲ್ಲವು?",
  "faqNotesA": "ಪರಿಶೀಲನಾ ಪಟ್ಟಿಗಳು ಮತ್ತು ಫಾರ್ಮ್ಯಾಟಿಂಗ್‌ನೊಂದಿಗೆ ಮುಕ್ತವಾಗಿ ಬರೆಯಿರಿ, ಮುಖ್ಯ ಟಿಪ್ಪಣಿಗಳನ್ನು ಪಿನ್ ಅಥವಾ ಮೆಚ್ಚಿನದು ಮಾಡಿ, ಟ್ಯಾಗ್‌ಗಳನ್ನು ಸೇರಿಸಿ ಮತ್ತು ಟಿಪ್ಪಣಿಗಳನ್ನು ಕಾರ್ಯಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡಿ. ಮೈಕ್ರೊಫೋನ್ ಬಟನ್ ಡಿಕ್ಟೇಟ್ ಮಾಡಲು ಅನುಮತಿಸುತ್ತದೆ. ಹೊಸ ಟಿಪ್ಪಣಿ ಟೆಂಪ್ಲೇಟ್‌ನಿಂದ (ಉಪನ್ಯಾಸ, ಪುಸ್ತಕ ಸಾರಾಂಶ, ದಿನಚರಿ, ವಾರದ ಯೋಜನೆ) ಪ್ರಾರಂಭವಾಗಬಹುದು, ಮತ್ತು ಚಿತ್ರ ಬಟನ್ ಫೋಟೋಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ.",
  "faqHabitsQ": "ಅಭ್ಯಾಸದ ಸರಣಿಗಳನ್ನು ಹೇಗೆ ಎಣಿಸಲಾಗುತ್ತದೆ?",
  "faqHabitsA": "ನಿಗದಿತ ದಿನದಂದು ಅಭ್ಯಾಸದ ಗುರಿ ತಲುಪಿದಾಗ ಆ ದಿನ ಎಣಿಕೆಯಾಗುತ್ತದೆ. ಅಭ್ಯಾಸವನ್ನು ವಿರಾಮಗೊಳಿಸಿದರೆ ಸರಣಿ ಸುರಕ್ಷಿತವಾಗಿರುತ್ತದೆ. ಪ್ರತಿ ಅಭ್ಯಾಸಕ್ಕೆ ತನ್ನದೇ ಜ್ಞಾಪನೆ ಸಮಯವಿರಬಹುದು.",
  "faqGoalsQ": "ಗುರಿಗಳು ಪ್ರಗತಿಯನ್ನು ಹೇಗೆ ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತವೆ?",
  "faqGoalsA": "ಗುರಿಗೆ ಗುರಿ ಮೊತ್ತ ಮತ್ತು ಘಟಕ ನೀಡಿ, ನಂತರ ಪ್ರಗತಿ ದಾಖಲಿಸಿ. ಅದರ ಕಾರ್ಡ್ ನೀವು ಎಷ್ಟು ದೂರ ಬಂದಿದ್ದೀರಿ ಮತ್ತು ಗಡುವಿಗೆ ಮೊದಲು ಎಷ್ಟು ಬಾಕಿ ಇದೆ ಎಂದು ತೋರಿಸುತ್ತದೆ.",
  "faqProjectsQ": "ಪ್ರಾಜೆಕ್ಟ್‌ಗಳು ಯಾವುದಕ್ಕಾಗಿ?",
  "faqProjectsA": "ಕಾರ್ಯಗಳನ್ನು ಪ್ರಾಜೆಕ್ಟ್ ಅಡಿಯಲ್ಲಿ ಗುಂಪು ಮಾಡಿ, ದಿನಾಂಕಗಳೊಂದಿಗೆ ಮೈಲಿಗಲ್ಲುಗಳನ್ನು ಸೇರಿಸಿ ಮತ್ತು ಒಟ್ಟಾರೆ ಪ್ರಗತಿಯನ್ನು ಅನುಸರಿಸಿ. ಮೈಲಿಗಲ್ಲುಗಳು ಕ್ಯಾಲೆಂಡರ್‌ನಲ್ಲೂ ಕಾಣಿಸುತ್ತವೆ.",
  "faqInsightsQ": "ಒಳನೋಟಗಳು ಏನನ್ನು ತೋರಿಸುತ್ತವೆ?",
  "faqInsightsA": "ದಿನಗಳು ಮತ್ತು ವಾರಗಳಲ್ಲಿ ನಿಮ್ಮ ಫೋಕಸ್ ಸಮಯ, ಮುಗಿದ ಕಾರ್ಯಗಳು ಮತ್ತು ಅಧ್ಯಯನ, ಸೌಮ್ಯ ಸಲಹೆಗಳೊಂದಿಗೆ. ಎಲ್ಲವನ್ನೂ ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲೇ ಲೆಕ್ಕಹಾಕಲಾಗುತ್ತದೆ.",
  "faqSpacesQ": "ಎಲ್ಲಾ ವಿಭಾಗಗಳು ಎಲ್ಲಿವೆ?",
  "faqSpacesA": "ವಿಭಾಗಗಳು ಆ್ಯಪ್‌ನ ಪ್ರತಿಯೊಂದು ಭಾಗವನ್ನು (ಟಿಪ್ಪಣಿಗಳು, ಡೆಕ್‌ಗಳು, ಅಭ್ಯಾಸಗಳು, ಗುರಿಗಳು, ಪ್ರಾಜೆಕ್ಟ್‌ಗಳು, ಧ್ವನಿಗಳು ಮತ್ತು ಇನ್ನಷ್ಟು) ಪಟ್ಟಿ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ಮುಖ್ಯ ಪಟ್ಟಿ ಸರಳವಾಗಿರುತ್ತದೆ.",
  "faqBackupQ": "ನನ್ನ ಡೇಟಾದ ಬ್ಯಾಕಪ್ ಹೇಗೆ ಆಗುತ್ತದೆ?",
  "faqBackupA": "ಪ್ರತಿದಿನ ಆ್ಯಪ್ ಮೌನವಾಗಿ ಈ ಫೋನ್‌ನಲ್ಲಿ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಪ್ರತಿಯನ್ನು ಇಡುತ್ತದೆ ಮತ್ತು ಕೊನೆಯ 7 ಅನ್ನು ಉಳಿಸುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಪಾಸ್‌ವರ್ಡ್ ರಕ್ಷಿತ ಬ್ಯಾಕಪ್ ಫೈಲ್ ರಫ್ತು ಮಾಡಿ ಇನ್ನೊಂದು ಫೋನ್‌ನಲ್ಲಿ ಮರುಸ್ಥಾಪಿಸಬಹುದು.",
  "faqPrayerQ": "ಪ್ರಾರ್ಥನಾ ಸಮಯಗಳು ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತವೆ?",
  "faqPrayerA": "ಸೆಟ್ಟಿಂಗ್‌ಗಳು → ಪ್ರಾರ್ಥನಾ ಸಮಯಗಳು ನಲ್ಲಿ ನಿಮ್ಮ ನಗರ ಆಯ್ಕೆಮಾಡಿ. ಸಮಯಗಳನ್ನು ಅಲ್ಲಿ ಬಳಸುವ ವಿಧಾನದಿಂದ ಫೋನ್‌ನಲ್ಲೇ ಲೆಕ್ಕಹಾಕಲಾಗುತ್ತದೆ, ಮತ್ತು ನೀವು ವಿಧಾನ ಮತ್ತು ಅಸ್ರ್ ಪಂಥವನ್ನು ಬದಲಾಯಿಸಬಹುದು. ಪ್ರತಿ ಪ್ರಾರ್ಥನೆಗೆ ನಿಮಗೆ ತಿಳಿಸಬಹುದು, ಮತ್ತು ನಡೆಯುತ್ತಿರುವ ಫೋಕಸ್ ಸೆಷನ್ ವಿರಾಮಗೊಳ್ಳುತ್ತದೆ.",
  "faqPrivacyQ": "ನನ್ನ ಡೇಟಾ ಎಲ್ಲಿ ಸಂಗ್ರಹವಾಗಿದೆ?",
  "faqPrivacyA": "ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ ಮಾತ್ರ, ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಡೇಟಾಬೇಸ್‌ನಲ್ಲಿ. ಯಾವುದೇ ಖಾತೆ ಮತ್ತು ಟ್ರ್ಯಾಕಿಂಗ್ ಇಲ್ಲ. ಇಂಟರ್ನೆಟ್ ಅನ್ನು ನೀವೇ ಆನ್ ಮಾಡುವ ವೈಶಿಷ್ಟ್ಯಗಳು ಮಾತ್ರ ಬಳಸುತ್ತವೆ, ಉದಾಹರಣೆಗೆ ಐಚ್ಛಿಕ ಸಹಾಯಕ.",
  "faqAssistantQ": "ಸಹಾಯಕ ಎಂದರೇನು?",
  "faqAssistantA": "ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮದೇ AI ಸೇವೆಗೆ ಸಂಪರ್ಕಿಸುವ ಐಚ್ಛಿಕ ಸಹಾಯಕ. ಇದು ಡೀಫಾಲ್ಟ್ ಆಗಿ ಆಫ್ ಆಗಿರುತ್ತದೆ ಮತ್ತು ಯಾವುದೇ ಟಿಪ್ಪಣಿ ಪಠ್ಯ ಕಳುಹಿಸುವ ಮೊದಲು ಕೇಳುತ್ತದೆ.",
  "tourPlanTitle": "ನಿಮ್ಮ ದಿನವನ್ನು ಯೋಜಿಸಿ",
