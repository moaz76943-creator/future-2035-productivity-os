<?xml version="1.0" encoding="utf-8"?>
<!-- All traffic must use TLS. The app is local-first; the only optional network
     use is a user-configured HTTPS assistant endpoint. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
