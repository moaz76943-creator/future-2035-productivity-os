<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude everything from cloud backup and device transfer. The
     encrypted database key lives in the Keystore and cannot be restored, so a
     copied database would be unreadable; users move data with encrypted
     in-app backups instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
